# Copie este archivo como .env y complete los valores.
# Nunca versione el archivo .env real.

PORT=3000
NODE_ENV=development

# Obligatorio: cadena aleatoria de al menos 32 caracteres.
# Ejemplo para generarla: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Contraseñas iniciales. Solo se usan si la tabla de usuarios está vacía.
# Si se dejan vacías, el servidor genera una contraseña temporal y la imprime en consola.
INITIAL_ADMIN_PASSWORD=
INITIAL_REVISOR_PASSWORD=

# IA (opcional). Sin clave, el escáner usa OCR local.
GEMINI_API_KEY=

# Base de datos. La aplicación opera con SQLite; MySQL se usa para
# exportar/migrar los datos a un servidor externo.
DB_ENGINE=sqlite
# Ruta opcional de la base SQLite. Por defecto: ./uploads/database.sqlite
# SQLITE_PATH=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL=false

# Copias de seguridad del archivo SQLite
# Carpeta de respaldos. Por defecto: ./backups
# BACKUP_DIR=
# Cuántas copias se conservan (las más recientes).
BACKUP_RETENTION=14
# Cada cuántas horas se crea una copia automática.
BACKUP_INTERVAL_HOURS=24
