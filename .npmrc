# Scripts de instalacion: HABILITADOS a proposito.
#
# better-sqlite3 12.x obtiene su binario nativo ejecutando su script `install`
# (prebuild-install descarga el prebuild de plataforma y solo compila si no lo
# encuentra). Este repo deshabilitaba los scripts con ignore-scripts=true para
# evitar toolchains de compilacion, pero eso deja el binario de SQLite sin
# instalar y rompe arranque y pruebas.
#
# Unicos paquetes con scripts: better-sqlite3, esbuild, core-js, protobufjs y
# tesseract.js. La reproducibilidad se sigue garantizando fijando el
# package-lock.json y usando siempre `npm ci`.

fund=false
